name: Lumen OS Pro ISO bauen
on:
  workflow_dispatch:
  push:
    branches: [main]
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - name: Debian-Schlüssel installieren
        run: sudo apt-get update && sudo apt-get install -y debian-archive-keyring
      - name: ISO bauen
        run: chmod +x build-lumen-os.sh && ./build-lumen-os.sh
      - name: Prüfsumme
        run: cd lumen-build && sha256sum lumen-os-pro-amd64.iso > lumen-os-pro-amd64.iso.sha256
      - uses: actions/upload-artifact@v4
        with:
          name: lumen-os-pro-amd64
          path: |
            lumen-build/lumen-os-pro-amd64.iso
            lumen-build/lumen-os-pro-amd64.iso.sha256
            lumen-build/build.log
